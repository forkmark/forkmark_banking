# ForkMark environment — copy to .env
FM_DB_PATH=~/.forkmark/forkmark.db
# FM_DATABASE_URL=postgresql://user:pass@localhost/forkmark
FM_HOST=127.0.0.1
FM_PORT=7700

# ── Secrets at rest ───────────────────────────────────────────────────────────
# Optional but recommended: enables Fernet encryption of stored provider API keys.
# If unset, provider keys are stored in plaintext. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# FM_SECRET_KEY=your-strong-secret-here

# ── Authentication (MANDATORY for financial-institution deployments) ──────────
# ForkMark requires an API key for ALL UI endpoints by DEFAULT — secure-by-default,
# including on loopback. Model validation evidence, human-review decisions, and the
# model inventory are supervisory records; keep this enabled in any regulated
# environment (SR 11-7, EU AI Act, PRA SS1/23, CBUAE).
FM_REQUIRE_UI_AUTH=true
# FM_REQUIRE_UI_AUTH=false       # escape hatch: isolated local dev ONLY, never with real data
# FM_BOOTSTRAP_TOKEN=my-secret   # one-time token to mint the first API key remotely

# ── Divergence scoring ────────────────────────────────────────────────────────
# FM_DIVERGENCE_SCORER=auto      # auto | lexical | semantic | openai | llm_judge
# FM_ST_MODEL=all-MiniLM-L6-v2   # sentence-transformers model
# FM_OPENAI_API_KEY=sk-...       # for openai / llm_judge scorers
# FM_EMBED_MODEL=text-embedding-3-small
# FM_JUDGE_MODEL=gpt-4o-mini
# FM_JUDGE_BASE_URL=https://api.openai.com/v1

# ── Background scoring ───────────────────────────────────────────────────────
# FM_BACKGROUND_WORKERS=4        # thread pool size for async scoring

# ── OpenTelemetry tracing ─────────────────────────────────────────────────────
# FM_ENABLE_OTEL=false            # enable OTel tracing (requires opentelemetry-sdk)
