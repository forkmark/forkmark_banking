# ── Stage 1: Build React frontend ─────────────────────────────────────────────
FROM node:20-alpine AS frontend-build
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# ── Stage 2: Python backend + built frontend ───────────────────────────────────
FROM python:3.11-slim
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend source
COPY . .

# Overlay the compiled frontend (replaces any stale local dist/)
COPY --from=frontend-build /app/frontend/dist ./frontend/dist

# Persistent data lives here (mounted as a Docker volume)
RUN mkdir -p /data

EXPOSE 7700

# Listen on all interfaces so Docker port-mapping works;
# SQLite DB stored in /data so it survives container restarts.
ENV FM_HOST=0.0.0.0 \
    FM_PORT=7700 \
    FM_DB_PATH=/data/forkmark.db

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "7700"]
